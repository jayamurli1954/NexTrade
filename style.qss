/* NexTrade Professional Financial Terminal Theme (High Contrast & Large Typography) */

/* Global Window */
QMainWindow, QDialog {
    background-color: #0B0E14;
    color: #F9FAFB;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
}

/* Tab Widget & Bar */
QTabWidget::pane {
    border: 1px solid #1E293B;
    background-color: #151A24;
    border-radius: 8px;
    top: -1px;
}

QTabBar {
    background-color: #0B0E14;
    qproperty-drawBase: 0;
    margin-bottom: 6px;
}

QTabBar::tab {
    background-color: #151A24;
    color: #CBD5E1;
    padding: 12px 22px;
    margin-right: 6px;
    border: 1px solid #1E293B;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 15px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #1E293B;
    color: #38BDF8;
    border-bottom: 3px solid #38BDF8;
    border-top: 1px solid #38BDF8;
    font-weight: 800;
}

QTabBar::tab:hover:!selected {
    background-color: #1E2532;
    color: #F8FAFC;
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6366F1, stop:1 #4F46E5);
    color: #FFFFFF;
    border: 1px solid #818CF8;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #818CF8, stop:1 #6366F1);
    border: 1px solid #A5B4FC;
}

QPushButton:pressed {
    background-color: #3730A3;
}

QPushButton:disabled {
    background-color: #1E293B;
    color: #64748B;
    border: 1px solid #334155;
}

/* Secondary Button Style */
QPushButton#secondaryBtn {
    background: #1E2532;
    color: #F1F5F9;
    border: 1px solid #334155;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#secondaryBtn:hover {
    background: #2A3447;
    border: 1px solid #475569;
    color: #FFFFFF;
}

/* Tables */
QTableWidget, QTableView {
    background-color: #151A24;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    gridline-color: #1E293B;
    font-size: 14px;
    selection-background-color: #1E293B;
    selection-color: #38BDF8;
    alternate-background-color: #0F172A;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #1E293B;
}

QHeaderView::section {
    background-color: #1E2532;
    color: #F8FAFC;
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid #38BDF8;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
}

/* Inputs & Form Controls */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit {
    background-color: #1E2532;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 500;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #38BDF8;
    background-color: #1E293B;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #0B0E14;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #475569;
}

/* Status Bar & Labels */
QStatusBar {
    background-color: #0B0E14;
    color: #E2E8F0;
    border-top: 1px solid #1E293B;
    font-size: 14px;
    font-weight: 600;
}

QLabel {
    color: #F1F5F9;
    font-size: 14px;
}

/* Universal Dialog & QMessageBox Styling */
QMessageBox, QDialog {
    background-color: #1E2532;
    border: 1px solid #334155;
    border-radius: 12px;
}

QMessageBox QLabel {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 500;
}

QMessageBox QPushButton {
    min-width: 110px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

/* Menu Styling */
QMenu {
    background-color: #1E2532;
    border: 1px solid #334155;
    color: #F8FAFC;
    padding: 6px;
    font-size: 14px;
}

QMenu::item:selected {
    background-color: #334155;
    color: #38BDF8;
}

/* ToolTip */
QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #38BDF8;
    padding: 8px;
    border-radius: 6px;
    font-size: 13px;
}
